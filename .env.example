# Nexa runtime
NEXA_ENV=development
NEXA_PRIMARY_PROVIDER=groq
NEXA_FALLBACK_PROVIDER=gemini
NEXA_RATE_LIMIT_PER_MINUTE=6
NEXA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Providers (use NEXA_PRIMARY_PROVIDER=mock sem fallback para testes offline)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
